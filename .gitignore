# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sample photos and videos saved by `pnpm download-media`; they load from
# Appica's media server otherwise
/public/demo/

# fonts saved from Fontshare by scripts/fontshare.mjs, whose license forbids
# sharing the files, so every copy of the project downloads its own
fontshare/

# local notes and tool state
CLAUDE.local.md
.impeccable/

# project documentation (generated)
_documentation/
\[_documentation\]/
