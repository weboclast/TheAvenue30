{
  "name": "appica-store-react",
  "version": "1.0.1",
  "private": true,
  "packageManager": "pnpm@11.28.7",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "node scripts/fontshare.mjs && next dev",
    "build": "node scripts/fontshare.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "eslint . && tsc --noEmit && prettier --check . && node .agents/scripts/sync-claude-skills.mjs --check",
    "sync:skills": "node .agents/scripts/sync-claude-skills.mjs",
    "sync:components": "node .agents/skills/appica-ui/scripts/sync-component-index.mjs",
    "download-media": "node scripts/download-media.mjs"
  },
  "dependencies": {
    "@appica/country-flags-react": "^1.1.0",
    "@appica/icons-react": "^1.1.0",
    "@appica/ui-react": "^1.4.0",
    "clsx": "^2.1.1",
    "motion": "^14.9.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dropzone": "^20.1.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
